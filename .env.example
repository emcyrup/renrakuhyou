##############################################################################
# 基本設定
##############################################################################
# 確認者ログインのパスワード（全員共通。名前は各自が入力する）
ADMIN_PASSWORD=change-me
# セッション Cookie の署名鍵。`openssl rand -base64 32` などで生成する
SESSION_SECRET=change-me-too
# 従業員に案内する確認画面の URL の起点。従業員のスマホから到達できる URL にする
APP_BASE_URL=http://localhost:3000
# SQLite の保存先
DATABASE_FILE=./data/renrakuhyou.sqlite
# 画面の時刻表示に使うタイムゾーン
TZ_DISPLAY=Asia/Tokyo

##############################################################################
# 未確認アラートとリマインド
##############################################################################
# 送信からこの時間を過ぎても未確認なら、確認者画面にポップアップし従業員へリマインドする
OVERDUE_HOURS=24
# リマインドを再送する最短間隔（時間）
REMINDER_INTERVAL_HOURS=24
# 1 配信あたりのリマインド上限回数
MAX_REMINDERS=3
# /api/cron/reminders を叩くときの Bearer トークン
CRON_SECRET=change-me-as-well

##############################################################################
# 既定のメッセージサービス（web_push | google_chat | line_works | line | mock）
##############################################################################
DEFAULT_PROVIDER=mock

##############################################################################
# アプリ通知 / Web Push（推奨: 外部サービスを使わない構成）
##############################################################################
# `npm run push:keys` で生成した鍵を貼り付ける
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# push サービスへの連絡先。mailto: または https: の URL
# VAPID_SUBJECT=mailto:admin@example.co.jp

##############################################################################
# Google Chat（推奨: Google Workspace 契約済みの場合）
##############################################################################
# サービスアカウントの鍵 JSON を 1 行にして貼る
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}
# Webhook 検証に使う Google Cloud プロジェクト番号
# GOOGLE_CHAT_AUDIENCE=123456789012
# ドメイン全体の委任を使う場合の代理実行ユーザー（任意）
# GOOGLE_IMPERSONATE_SUBJECT=admin@example.co.jp

##############################################################################
# LINE WORKS（推奨: Google Workspace を使っていない場合）
##############################################################################
# LINEWORKS_CLIENT_ID=
# LINEWORKS_CLIENT_SECRET=
# LINEWORKS_SERVICE_ACCOUNT=xxxxx.serviceaccount@example
# LINEWORKS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...
# LINEWORKS_BOT_ID=
# LINEWORKS_BOT_SECRET=

##############################################################################
# LINE 公式アカウント（Messaging API）
##############################################################################
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=
