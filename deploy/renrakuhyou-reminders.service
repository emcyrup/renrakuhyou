# 未確認者へのリマインド送信（タイマーから呼ばれる）
# 設置先: /etc/systemd/system/renrakuhyou-reminders.service
[Unit]
Description=連絡票 リマインド送信
After=renrakuhyou.service

[Service]
Type=oneshot
# CRON_SECRET だけを書いた専用ファイル（.env とは分ける）
EnvironmentFile=/etc/renrakuhyou-cron.env
ExecStart=/usr/bin/curl -fsS --max-time 120 -X POST \
  -H "Authorization: Bearer ${CRON_SECRET}" \
  http://127.0.0.1:3000/api/cron/reminders
